{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nimatestserver",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b9920d35-11b9-45ae-b4ec-abda7a2711de","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "aea7d70c1c964fa6bac87c80d0934d6e" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
